  "ld-scriptsyml": {
    "prefix": "ld-scriptsyml",
    "body": [
      "init: |-",
      "  action.time('night');",
      "start:",
      "  条件:",
      "    - 在线玩家数 >= 1",
      "  脚本: |-",
      "    action.title('@all', '&6&l示例副本', '&7消灭所有敌人');",
      "    action.spawn_group('wave_1');",
      "complete: |-",
      "  action.grant_reward('@all', '通关奖励');",
      "fail: |-",
      "  action.title('@all', '&c挑战失败', '&7再接再厉');"
    ],
    "description": "生命周期脚本钩子 —— 最小可用模板"
  },
  "ld-functionsjs": {
    "prefix": "ld-functionsjs",
    "body": [
      "// 副本目录下的每个 .js 都会被读入，本副本所有脚本都能直接按名字调用这里的函数",
      "// 函数名/变量名用中文完全可以；但「条件:」里会先做中文关键词替换，",
      "// 名字里不要出现 是/否/击杀数/存活怪物/剩余怪物/在线人数/运行时间/并且/或者（见 7.6.3）",
      "// 内置对象：action / dungeon / player / trigger（后两个只在有触发者的钩子里存在）",
      "// 内置函数：getVar(名字)（不存在时返回 0）/ setVar(名字, 值) / log(内容) / parseTime('3秒') / playerName()",
      "",
      "// 例 1：封装一句提示，别处直接写  喊话('第一波来了')",
      "function 喊话(内容) {",
      "    action.message('@all', '&e' + 内容);",
      "}",
      "",
      "// 例 2：用中文变量记进度，并在函数里调用另一个函数",
      "function 记进度(说明) {",
      "    var 当前进度 = getVar('进度') + 1;      // 第一次调用返回 0 → 1",
      "    setVar('进度', 当前进度);",
      "    喊话('进度 ' + 当前进度 + '：' + 说明);",
      "}",
      "",
      "// 例 3：读副本状态再决定说什么",
      "function 报还剩几只(怪物组) {",
      "    var 剩余 = dungeon.getAliveMonsterCount(怪物组);",
      "    if (剩余 > 0) {",
      "        喊话('「' + 怪物组 + '」还剩 ' + 剩余 + ' 只');",
      "    } else {",
      "        喊话('「' + 怪物组 + '」已经清空');",
      "    }",
      "}",
      "",
      "// 例 4：只发给触发者本人（没有触发者时会跳过）",
      "function 私聊(内容) {",
      "    if (typeof player === 'undefined' || player === null) {",
      "        log('私聊()：这次调用没有触发者，内容未发出 —— ' + 内容);",
      "        return;",
      "    }",
      "    action.message('@trigger', '&a' + 内容);",
      "}"
    ],
    "description": "JavaScript 函数库 —— 最小可用模板"
  },
  "ld-message": {
    "prefix": "ld-message",
    "body": [
      "action.message('@all', '&e${1:文本}');"
    ],
    "description": "给全队发消息的一行脚本（写进 |- 块里）"
  },
  "ld-script-block": {
    "prefix": "ld-script",
    "body": [
      "${1:start}: |-",
      "  action.message('@all', '&e${2:开始}');"
    ],
    "description": "钩子 + 一行脚本（|- 块写法）"
  }
}
