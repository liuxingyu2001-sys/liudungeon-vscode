      "example": "groups:\n  wave_1:\n    spawn_timing:\n      type: AUTO_START\n    monsters:\n      - id: Zombie\n        location: '0,64,-10'\n        amount: 3\n        level: 1\n  boss:\n    spawn_timing:\n      type: TRIGGERED\n    trigger_group: wave_1\n    monsters:\n      - id: Husk\n        location: '0,64,-20'\n        amount: 1\n        boss: true\n",
